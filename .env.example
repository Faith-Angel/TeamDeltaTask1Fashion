# ============================================================
# NdoloStitch — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================


# ------------------------------------------------------------
# SUPABASE (Faith)
# Dashboard → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://fpbaigbmlcnuvchzblvl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_aoh8_n_xiS2OLsBxjLoOow_f1rzQSSq
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# DATABASE (Faith)
# Supabase → Project Settings → Database → Connection string
# Use the "Transaction" mode pooler URL for Prisma (port 6543)
# Use the "Session" mode URL for direct migrations (port 5432)
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres.fpbaigbmlcnuvchzblvl:tnYbvQTM8iWqA6PY@aws-1-us-west-2.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.fpbaigbmlcnuvchzblvl:tnYbvQTM8iWqA6PY@aws-1-us-west-2.pooler.supabase.com:5432/postgres"


# ------------------------------------------------------------
# REDIS — Upstash (Faith / Deyo)
# console.upstash.com → Create Database → REST API
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ------------------------------------------------------------
# INNGEST — Background Jobs (Faith)
# app.inngest.com → Your App → Keys
# ------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# ------------------------------------------------------------
# OPENAI — GPT-4o + DALL-E 3 (Gabe / Faith proxy)
# platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=


# ------------------------------------------------------------
# PINECONE — Vector Database (Gabe)
# app.pinecone.io → API Keys
# ------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=ndolostitch-fashion
PINECONE_ENVIRONMENT=


# ------------------------------------------------------------
# ML SERVICE (Gabe)
# URL where the FastAPI service is running locally or deployed
# ------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=


# ------------------------------------------------------------
# SMS — Twilio (Faith)
# console.twilio.com → Account Info
# Used for phone-number OTP verification during registration
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX


# ------------------------------------------------------------
# EMAIL — Resend (Faith)
# resend.com → API Keys
# Used for transactional emails (order confirmations, etc.)
# ------------------------------------------------------------
RESEND_API_KEY=


# ------------------------------------------------------------
# PAYMENT — MTN Mobile Money (Faith)
# momodeveloper.mtn.com → Sandbox / Production credentials
# ------------------------------------------------------------
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
# sandbox | production


# ------------------------------------------------------------
# PAYMENT — Orange Money (Faith)
# developer.orange.com → My Apps → Credentials
# ------------------------------------------------------------
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_ENVIRONMENT=sandbox
# sandbox | production


# ------------------------------------------------------------
# PAYMENT — Webhook Security (Faith)
# A random secret used to sign and verify provider webhooks
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=


# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
