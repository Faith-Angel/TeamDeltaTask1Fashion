# ============================================================
# NdoloStitch — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================


# ------------------------------------------------------------
# SUPABASE (Faith)
# Get these from: https://supabase.com/dashboard → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# DATABASE (Faith)
# Prisma connection string — from Supabase → Settings → Database
# ------------------------------------------------------------
DATABASE_URL=


# ------------------------------------------------------------
# OPENAI — GPT-4o (Gabe)
# Get from: https://platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=


# ------------------------------------------------------------
# PINECONE — Vector Database (Gabe)
# Get from: https://app.pinecone.io
# ------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=ndolostitch-fashion
PINECONE_ENVIRONMENT=


# ------------------------------------------------------------
# ML SERVICE (Gabe)
# URL where the FastAPI service is running
# ------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=


# ------------------------------------------------------------
# REDIS — Upstash (Faith / Deyo)
# Get from: https://console.upstash.com
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ------------------------------------------------------------
# SMS / EMAIL (Faith)
# Twilio for SMS OTP, Resend for email
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=


# ------------------------------------------------------------
# INNGEST — Background Jobs (Faith)
# Get from: https://app.inngest.com
# ------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
