# ─────────────────────────────────────────────────────────────────────────
# NdoloStitch ML Service — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────

# ── API Security ──────────────────────────────────────────────────────────
# Shared secret between the Next.js monolith and this service.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_SERVICE_API_KEY=your-secret-api-key-here

# ── Google Gemini (free tier) ─────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Free tier: gemini-2.0-flash — 15 RPM, 1M TPM, no cost
GOOGLE_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Pinecone ──────────────────────────────────────────────────────────────
# Get your key at: https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=ndolostitch-fashion
# Dimension must match CLIP ViT-B/32 output (512)
PINECONE_DIMENSION=512
PINECONE_METRIC=cosine

# ── CLIP model ────────────────────────────────────────────────────────────
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
# Where to cache downloaded model weights (mounted as Docker volume)
MODEL_CACHE_DIR=/model-cache

# ── Caching ───────────────────────────────────────────────────────────────
# How long to cache embedding results in memory (seconds)
CACHE_TTL_SECONDS=3600
# Maximum number of embeddings to keep in LRU cache
CACHE_MAX_SIZE=512

# ── Circuit Breaker ───────────────────────────────────────────────────────
# Consecutive failures before opening the circuit
CIRCUIT_BREAKER_THRESHOLD=5
# Seconds to stay open before probing again
CIRCUIT_BREAKER_TIMEOUT=60

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (the Next.js monolith URLs)
ALLOWED_ORIGINS=["http://localhost:3000","https://ndolostitch.vercel.app"]
